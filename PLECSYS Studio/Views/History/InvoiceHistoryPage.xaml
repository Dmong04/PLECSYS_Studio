<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PLECSYS_Studio.ViewModels.History"
             x:Class="PLECSYS_Studio.Views.History.InvoiceHistoryPage"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- 🔹 Encabezado -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource PrimaryDarkBlue}"
              HeightRequest="50"
              Padding="16,15"
              ColumnDefinitions="Auto,*">
            <ImageButton Source="goback.png"
                         WidthRequest="24"
                         HeightRequest="24"
                         BackgroundColor="Transparent"
                         Command="{Binding GoBackCommand}" />
        </Grid>

        <!-- 🔹 Título -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="24,12,24,6"
                             Spacing="4">
            <Label Text="Histórico"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryDarkBlue}"
                   HorizontalOptions="Center" />
            <BoxView HeightRequest="1"
                     BackgroundColor="{StaticResource MediumGray}"
                     HorizontalOptions="Fill" />
        </VerticalStackLayout>

        <!-- 🔹 Contenido -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="24,20"
                             Spacing="12"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">

            <Label Text="{Binding InvoiceConsecutive, StringFormat='Factura asociada: #{0}'}"
                   FontAttributes="Bold"
                   FontSize="15"
                   TextColor="{StaticResource PrimaryDarkBlue}"
                   HorizontalOptions="Start" />

            <!-- 🔸 Filtros centrados -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Border Stroke="{StaticResource MediumGray}"
                        StrokeThickness="1"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 12"
                        Padding="6,0"
                        HeightRequest="40"
                        WidthRequest="120">
                    <Picker ItemsSource="{Binding ActionsFilter}"
                            SelectedItem="{Binding SelectedAction}"
                            Title="Evento"
                            FontSize="12"
                            HorizontalOptions="Fill"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryDarkBlue}" />
                </Border>

                <HorizontalStackLayout VerticalOptions="Center">
                    <Label Text="Ordenar por fecha reciente"
                           FontSize="12"
                           TextColor="{StaticResource PrimaryDarkBlue}"
                           VerticalOptions="Center" />
                    <Switch IsToggled="{Binding SortDescending}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <!-- 🔸 Historial con EmptyView visible -->
            <RefreshView Command="{Binding LoadCommand}"
                         IsRefreshing="{Binding IsBusy}"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill">
                <CollectionView ItemsSource="{Binding Items}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Padding="40,60"
                                             Spacing="10">
                            <Image Source="empty.png"
                                   WidthRequest="90"
                                   HeightRequest="90"
                                   Aspect="AspectFit" />
                            <Label Text="Sin eventos que mostrar..."
                                   FontAttributes="Italic"
                                   FontSize="14"
                                   TextColor="{StaticResource MediumGray}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{StaticResource LightGray}"
                                    StrokeThickness="1"
                                    Padding="14"
                                    Margin="10,6"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="Transparent">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Action, StringFormat='Acción: {0}'}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDarkBlue}" />
                                    <Label Text="{Binding RecordDate, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                           TextColor="{StaticResource PrimaryDarkBlue}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </VerticalStackLayout>

        <!-- 🔹 Botón centrado -->
        <VerticalStackLayout Grid.Row="3"
                             Padding="0,20"
                             HorizontalOptions="Center"
                             VerticalOptions="End">
            <Border StrokeThickness="0"
                    BackgroundColor="{StaticResource PrimaryDarkBlue}"
                    StrokeShape="RoundRectangle 25"
                    HeightRequest="45"
                    WidthRequest="175"
                    Padding="10"
                    HorizontalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExportCsvCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="8"
                                        HorizontalOptions="Center">
                    <Image Source="excel.png"
                           WidthRequest="20"
                           HeightRequest="20"
                           Aspect="AspectFit" />
                    <Label Text="Exportar CSV"
                           TextColor="White"
                           FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
