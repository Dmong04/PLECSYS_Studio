<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PLECSYS_Studio.Views.History.ClaimHistoryPage"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource PrimaryDarkBlue}"
              HeightRequest="60"
              Padding="16,15"
              ColumnDefinitions="Auto,*">

            <ImageButton Source="goback.png"
                         WidthRequest="24"
                         HeightRequest="24"
                         BackgroundColor="Transparent"
                         Command="{Binding GoBackCommand}"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Padding="24,12,24,6"
                             Spacing="4">

            <Label Text="Historico de Reclamos"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryDarkBlue}"
                   HorizontalOptions="Center"/>

            <BoxView HeightRequest="1"
                     BackgroundColor="{StaticResource MediumGray}"
                     HorizontalOptions="Fill"/>
        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <!-- Loader -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                ZIndex="1"/>

            <CollectionView ItemsSource="{Binding Claims}">

                <CollectionView.Header>
                    <VerticalStackLayout Padding="20,16,20,8">
                        <Button Text="Hacer Reclamo"
                                HeightRequest="40"
                                BackgroundColor="{StaticResource PrimaryDarkBlue}"
                                TextColor="White"
                                CornerRadius="20"
                                HorizontalOptions="Start"
                                WidthRequest="160"
                                Clicked="OnRegisterClaimClicked"/>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border StrokeShape="RoundRectangle 15"
                                Stroke="#D9D9D9"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="20,0,20,12"
                                BackgroundColor="White">

                            <VerticalStackLayout Spacing="4">

                                <Label Text="{Binding Action, StringFormat='Ación: {0}'}"
                                       FontAttributes="Bold" FontSize="15"
                                       TextColor="{StaticResource PrimaryDarkBlue}" />

                                <Label Text="{Binding Consecutive, StringFormat='Numero de factura: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource PrimaryDarkBlue}" />

                                <Label Text="{Binding Pending_balance, StringFormat='Saldo pendiente: ₡{0:F2}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource PrimaryDarkBlue}" />

                                <Label Text="{Binding New_status, StringFormat='Estado: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource PrimaryDarkBlue}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>
