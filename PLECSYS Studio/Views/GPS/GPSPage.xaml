<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="PLECSYS_Studio.Views.GPS.GPSPage"
             Title="Registrar Ruta de Vendedor">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Registro de Ruta"
               FontSize="22"
               HorizontalOptions="Center"
               FontAttributes="Bold" />

        <!-- Seller ID -->
        <Entry Placeholder="ID del vendedor"
               Text="{Binding Seller_id}" />

        <!-- Mapa -->
        <maps:Map x:Name="UserMap"
                  MapClicked="OnMapClicked"
                  HeightRequest="300"
                  IsShowingUser="True" />

        <!-- Botón para guardar -->
        <Button Text="Guardar ruta"
                Command="{Binding SaveRouteCommand}"
                BackgroundColor="{StaticResource PrimaryDarkBlue}"
                TextColor="{StaticResource White}"
                CornerRadius="8" />

        <!-- Mensaje de estado -->
        <Label Text="{Binding StatusMessage}"
               FontSize="16"
               HorizontalOptions="Center"
               VerticalOptions="End" />

    </VerticalStackLayout>
</ContentPage>
