<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PLECSYS_Studio.Views.SignUp.SignUpPage"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView>

            <VerticalStackLayout Padding="30" Spacing="15">

                <VerticalStackLayout Grid.Row="1" Padding="24,12,24,6" Spacing="4">
                    <Label Text="Registro Nuevo Usuario" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryDarkBlue}" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource LightGray}" HorizontalOptions="Fill" />
                </VerticalStackLayout>

                <Entry Placeholder="Correo electronico"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   BackgroundColor="Transparent"/>

                <Entry Placeholder="Nombre"
                   Text="{Binding Name}"
                   BackgroundColor="Transparent"/>

                <HorizontalStackLayout>
                    <Entry Placeholder="Primer apellido"
                       Text="{Binding First_lastname}" 
                       BackgroundColor="Transparent"
                       HorizontalOptions="Fill"
                       WidthRequest="150"/>

                    <Entry Placeholder="Segundo apellido"
                       Text="{Binding Second_lastname}" 
                       BackgroundColor="Transparent"
                       HorizontalOptions="Fill" 
                       WidthRequest="150"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Picker Title="Código"
                        WidthRequest="100"
                        SelectedItem="{Binding PhoneCode}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>+506</x:String>
                                <x:String>+502</x:String>
                                <x:String>+507</x:String>
                                <x:String>+593</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Entry Placeholder="Teléfono"
                       Text="{Binding Phone}"
                       Keyboard="Telephone"
                       HorizontalOptions="Fill"
                       BackgroundColor="Transparent"/>
                </HorizontalStackLayout>

                <Entry Placeholder="Contraseña"
                   Text="{Binding Password}"
                   IsPassword="True" 
                   BackgroundColor="Transparent"/>

                <Entry Placeholder="Confirmar contraseña"
                   Text="{Binding ConfirmPassword}"
                   IsPassword="True"
                   BackgroundColor="Transparent"/>


                <HorizontalStackLayout VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding TermsAccepted}" />
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Acepto" />
                                <Span Text="términos y condiciones" 
                                  TextColor="{StaticResource AccentOrange}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>

                <Border StrokeThickness="0"
                BackgroundColor="{StaticResource PrimaryBlue}"
                StrokeShape="RoundRectangle 12"
                HeightRequest="45"
                WidthRequest="300"
                Padding="10"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SignUpCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">

                        <Label Text="Crear cuenta"
                       VerticalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"/>

                    </HorizontalStackLayout>

                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource AccentOrange}"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="45"
                        WidthRequest="300"
                        Padding="10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Volver al inicio"
                               VerticalOptions="Center"
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <Grid Grid.Row="1" HeightRequest="120">

            <Path Fill="{DynamicResource PrimaryBlue}"
          Aspect="Fill"
          Data="M0,80 C150,150 300,50 500,120 L500,150 L0,150 Z"/>

            <Path Fill="{DynamicResource PrimaryDarkBlue}"
          Aspect="Fill"
          Data="M0,100 C150,0 300,200 500,100 L500,150 L0,150 Z"/>

        </Grid>

    </Grid>

</ContentPage>