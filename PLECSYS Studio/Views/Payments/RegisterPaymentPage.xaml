<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="PLECSYS_Studio.Views.Payments.RegisterPaymentPage"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">


        <Grid Grid.Row="0" BackgroundColor="{StaticResource PrimaryDarkBlue}" HeightRequest="50" Padding="16,15" ColumnDefinitions="Auto,*">

            <ImageButton Source="goback.png" WidthRequest="24" HeightRequest="24"
                         Background="Transparent"
                         Command="{Binding GoBackCommand}"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="24,12,24,6" Spacing="4">
            <Label Text="Pago" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryDarkBlue}" HorizontalOptions="Center"/>

            <BoxView HeightRequest="1" BackgroundColor="{StaticResource MediumGray}" HorizontalOptions="Fill" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="2" Padding="0,0,0,20">

            <VerticalStackLayout Padding="24,20" Spacing="12" HorizontalOptions="Center" WidthRequest="330">

                <Label Text="{Binding InvoiceConsecutive, StringFormat='Factura asociada: #{0}'}"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="{StaticResource PrimaryDarkBlue}" />

                <Label Text="Consecutivo de pago"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDarkBlue}" />

                <Border Stroke="{StaticResource PrimaryDarkBlue}"
                    StrokeThickness="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">
                    <Entry Placeholder="{Binding InvoiceConsecutive}"
                           Text="{Binding PaymentConsecutive}"
                           FontSize="14"
                           Keyboard="Numeric"
                           IsReadOnly="True"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource MediumGray}" />
                </Border>

                <Label Text="Moneda"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDarkBlue}" />

                <Border Stroke="{StaticResource PrimaryDarkBlue}"
                    StrokeThickness="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">
                    <Picker ItemsSource="{Binding Currencies}"
                            SelectedItem="{Binding SelectedCurrency}"
                            ItemDisplayBinding="{Binding CurrencyName}"
                            Title="Seleccione una moneda"
                            FontSize="14"
                            TextColor="{StaticResource PrimaryDarkBlue}"
                            BackgroundColor="Transparent" />
                </Border>


                <Label Text="Método de pago"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDarkBlue}" />

                <Border Stroke="{StaticResource PrimaryDarkBlue}"
                    StrokeThickness="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">
                    <Picker ItemsSource="{Binding PaymentMethods}"
                            ItemDisplayBinding="{Binding PaymentMethodName}"
                            SelectedItem="{Binding SelectedPaymentMethod}"
                            Title="Seleccione un método"
                            FontSize="14"
                            TextColor="{StaticResource PrimaryDarkBlue}"
                            BackgroundColor="Transparent" />
                </Border>

                <Grid>
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsOtherMethod}" Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Grid.Triggers>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Detalle del método"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDarkBlue}" />
                        <Border Stroke="{StaticResource PrimaryDarkBlue}"
            StrokeThickness="1.2"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            StrokeShape="RoundRectangle 8"
            Padding="6,2"
            HeightRequest="80">
                            <Editor Placeholder="Especifique el método de pago"
                Text="{Binding OtherMethodDetail}"
                AutoSize="Disabled"
                BackgroundColor="Transparent"
                TextColor="{StaticResource PrimaryDarkBlue}"
                FontSize="14" />
                        </Border>
                    </VerticalStackLayout>


                </Grid>

                <Label Text="Monto"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDarkBlue}" />

                <Border Stroke="{StaticResource PrimaryDarkBlue}"
                    StrokeThickness="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">
                    <Entry Placeholder="0.00"
                           Keyboard="Numeric"
                           Text="{Binding Amount}"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource PrimaryDarkBlue}"
                           FontSize="14"/>
                </Border>

                <Label Text="Fecha de pago"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDarkBlue}" />

                <Border Stroke="{StaticResource PrimaryDarkBlue}"
                    StrokeThickness="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,0">

                    <HorizontalStackLayout Spacing="8">
                        <Image Source="calendar.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               Aspect="AspectFit" />
                        <DatePicker Date="{Binding PaymentDate}"
                                    Format="dd/MM/yyyy"
                                    MaximumDate="{x:Static sys:DateTime.Now}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource PrimaryDarkBlue}" 
                                    FontSize="14"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Detalle del pago -->
                <Label Text="Detalle del pago"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDarkBlue}" />

                <Border Stroke="{StaticResource PrimaryDarkBlue}"
                        StrokeThickness="2"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Fill"
                            StrokeShape="RoundRectangle 8"
                            Padding="6,2"
                            HeightRequest="100">

                    <Editor Placeholder="Ingrese los detalles del pago...       "
                            Text="{Binding PaymentDetail}"
                            AutoSize="Disabled"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryDarkBlue}"
                            FontSize="14"/>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource PrimaryDarkBlue}"
                        StrokeShape="RoundRectangle 25"
                        HeightRequest="45"
                        WidthRequest="100"
                        Padding="10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Guardar"
                               VerticalOptions="Center"
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>