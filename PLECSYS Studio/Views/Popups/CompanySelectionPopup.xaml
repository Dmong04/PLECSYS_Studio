<?xml version="1.0" encoding="utf-8" ?>
<views:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    x:Class="PLECSYS_Studio.Views.Popups.CompanySelectionPopup"
    HorizontalOptions="Center"
    VerticalOptions="Center"
    BackgroundColor="Transparent"
    Padding="0"
    Margin="0">

    <Border
        BackgroundColor="White"
        Padding="20"
        WidthRequest="320"
        Stroke="{StaticResource LightGray}">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="15">

            <!-- Header -->
            <Label
                Text="Selecciona una compañía"
                FontAttributes="Bold"
                FontSize="18"
                TextColor="{StaticResource PrimaryDarkBlue}"
                HorizontalOptions="Center"/>

            <Label
                Text="Elige con cuál compañía deseas trabajar en esta sesión."
                FontSize="13"
                TextColor="{StaticResource MediumGray}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"/>

            <!-- Lista de compañías -->
            <CollectionView
                ItemsSource="{Binding Companies}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource PrimaryDarkBlue}"
                            StrokeShape="RoundRectangle 25"
                            HeightRequest="38"
                            Margin="0,4"
                            Padding="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="280">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type views:Popup}}, Path=BindingContext.SelectCompanyCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Image Source="company.png"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       Aspect="AspectFit"/>
                                <Label
                                    Text="{Binding company_name}"
                                    VerticalOptions="Center"
                                    TextColor="White"
                                    FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Border>

</views:Popup>