<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PLECSYS_Studio.ViewModels.SmartFlow"
             xmlns:model="clr-namespace:PLECSYS_Studio.Wrappers.Users"
             x:DataType="vm:SmartFlowViewModel"
             x:Class="PLECSYS_Studio.Views.SmartFlow.SmartFlowPage">

    <ContentPage.Content>
        <VerticalStackLayout Spacing="0">

            <!-- Barra de búsqueda -->
            <Border
                Margin="16,16,16,8"
                BackgroundColor="White"
                StrokeThickness="1"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 30"
                Padding="12,0">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Image
                        Source="search_icon.png"
                        WidthRequest="18"
                        HeightRequest="18"
                        Aspect="AspectFit"
                        VerticalOptions="Center"/>
                    <Entry
                        Text="{Binding SearchText}"
                        Placeholder="Buscar..."
                        PlaceholderColor="#AAAAAA"
                        TextColor="#333333"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Lista de procesos -->
            <CollectionView
                ItemsSource="{Binding Processes}"
                SelectionMode="None"
                Margin="16,8,16,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:SmartFlowOption">
                        <Border
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E8E8E8"
                            StrokeShape="RoundRectangle 12"
                            Padding="16,14"
                            Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SmartFlowViewModel}}, Path=SelectProcessCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <!-- Nombre del proceso -->
                                <Label
                                    Text="{Binding smartflow_name}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource PrimaryDarkBlue}"/>
                                <!-- Siguiente paso -->
                                <Label
                                    Text="{Binding next_step_name, StringFormat='Siguiente paso: {0}'}"
                                    FontSize="13"
                                    TextColor="{StaticResource MediumGray}"/>
                                <!-- Aprobador -->
                                <Label
                                    Text="{Binding approver, StringFormat='Aprobador: {0}'}"
                                    FontSize="13"
                                    TextColor="{StaticResource MediumGray}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Estado vacío -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8"
                        Margin="0,40,0,0">
                        <Label
                            Text="Sin procesos habilitados"
                            FontSize="15"
                            TextColor="{StaticResource MediumGray}"
                            HorizontalOptions="Center"/>
                        <Label
                            Text="No se encontraron procesos para tu usuario."
                            FontSize="13"
                            TextColor="{StaticResource MediumGray}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
